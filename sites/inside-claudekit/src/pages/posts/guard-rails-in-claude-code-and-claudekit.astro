<script is:inline>
(function(){
  var tt = document.getElementById('tt');
  var cur0 = document.documentElement.getAttribute('data-theme') || 'dark';
  tt.textContent = cur0 === 'dark' ? '☀' : '☾';
  tt.addEventListener('click', function(){
    var cur = document.documentElement.getAttribute('data-theme') || 'dark';
    var nx = cur === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', nx);
    try { localStorage.setItem('theme', nx); } catch (_) {}
    tt.textContent = nx === 'dark' ? '☀' : '☾';
  });
})();

(function(){
  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function(resolve, reject) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.top = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy') ? resolve() : reject(new Error('copy failed'));
      } catch (err) {
        reject(err);
      } finally {
        document.body.removeChild(ta);
      }
    });
  }

  function addCopyButton(node, getText) {
    if (node.querySelector(':scope > .copy-btn')) return;
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', function() {
      copyText(getText().trim()).then(function() {
        btn.textContent = 'Copied';
        btn.classList.add('is-copied');
        window.setTimeout(function() {
          btn.textContent = 'Copy';
          btn.classList.remove('is-copied');
        }, 1200);
      }).catch(function() {
        btn.textContent = 'Error';
        window.setTimeout(function() { btn.textContent = 'Copy'; }, 1200);
      });
    });
    node.appendChild(btn);
  }

  document.querySelectorAll('pre.code').forEach(function(pre) {
    addCopyButton(pre, function() {
      var clone = pre.cloneNode(true);
      clone.querySelectorAll('.copy-btn').forEach(function(btn) { btn.remove(); });
      return clone.textContent;
    });
  });

  document.querySelectorAll('.config-snippet').forEach(function(box) {
    addCopyButton(box, function() {
      var code = box.querySelector('code');
      return code ? code.textContent : '';
    });
  });
})();
</script>
