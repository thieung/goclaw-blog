<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Khi nào dùng /ck:plan --deep --tdd</title>
  <meta name="description" content="--deep giúp plan nhìn rõ scope; --tdd thêm regression gate cho refactor. Bài này tách rõ khi nào dùng từng option, khi nào không cần bật." />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
          return;
        }
        document.documentElement.dataset.theme = 'dark';
      } catch (_) {
        document.documentElement.dataset.theme = 'dark';
      }
    })();
  </script>
  <style is:inline>
    :root {
      color-scheme: light;
      --bg: oklch(98% 0.004 95);
      --surface: oklch(100% 0.002 95);
      --fg: oklch(20% 0.018 70);
      --muted: oklch(48% 0.012 70);
      --border: oklch(90% 0.006 95);
      --accent: oklch(52% 0.10 28);
      --accent-strong: oklch(45% 0.12 28);
      --accent-soft: oklch(95% 0.018 35);
      --code-bg: oklch(24% 0.018 70);
      --code-fg: oklch(96% 0.006 95);
      --success: oklch(52% 0.13 145);
      --warn: oklch(64% 0.13 72);
      --danger: oklch(55% 0.16 25);

      --font-display: 'Iowan Old Style', 'Charter', Georgia, serif;
      --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      --max-reader: 760px;
      --max-page: 1120px;
    }

    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: oklch(16% 0.014 70);
      --surface: oklch(20% 0.014 70);
      --fg: oklch(93% 0.006 95);
      --muted: oklch(72% 0.012 82);
      --border: oklch(34% 0.012 70);
      --accent: oklch(70% 0.12 42);
      --accent-strong: oklch(78% 0.13 45);
      --accent-soft: oklch(30% 0.05 42);
      --code-bg: oklch(12% 0.018 70);
      --code-fg: oklch(94% 0.006 95);
      --success: oklch(70% 0.13 145);
      --warn: oklch(76% 0.13 72);
      --danger: oklch(70% 0.16 25);
    }

    * { box-sizing: border-box; }
    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }
    body {
      margin: 0;
      color: var(--fg);
      background: var(--bg);
      font-family: var(--font-body);
      font-size: 17px;
      line-height: 1.76;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration-color: color-mix(in oklch, var(--accent) 70%, transparent);
      text-decoration-thickness: 1.5px;
      text-underline-offset: 0.18em;
    }

    .progress {
      position: fixed;
      inset: 0 0 auto 0;
      height: 4px;
      z-index: 30;
      background: color-mix(in oklch, var(--accent) 24%, transparent);
    }
    .progress span {
      display: block;
      width: 0%;
      height: 100%;
      background: var(--accent);
      transition: width 0.08s linear;
    }

    .page {
      max-width: var(--max-page);
      margin: 0 auto;
      padding: 24px clamp(18px, 4vw, 48px) 84px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 58px;
      border-bottom: 1px solid var(--border);
      margin-bottom: clamp(34px, 6vw, 72px);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.02em;
      color: var(--muted);
    }
    .series {
      display: flex;
      align-items: center;
      gap: 14px;
      color: var(--fg);
      font-weight: 700;
    }
    .series-name {
      color: var(--accent-strong);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .series-product {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .series-product::before {
      content: "";
      width: 32px;
      height: 1px;
      background: color-mix(in oklch, var(--accent) 60%, var(--border));
    }
    .meta-line {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px 16px;
      text-align: right;
    }
    .theme-toggle,
    .home-link {
      flex: 0 0 auto;
      min-height: 34px;
      padding: 0 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: color-mix(in oklch, var(--surface) 88%, transparent);
      color: var(--fg);
      font: 700 11px/1 var(--font-mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
      transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
    }
    .home-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }
    .home-link svg {
      width: 14px;
      height: 14px;
    }
    .theme-toggle:hover,
    .home-link:hover {
      border-color: var(--accent);
      background: color-mix(in oklch, var(--accent-soft) 64%, var(--surface));
      color: var(--fg);
    }

    .post-footer {
      display: flex;
      justify-content: center;
      padding: clamp(36px, 6vw, 56px) 0 clamp(48px, 7vw, 72px);
      border-top: 1px solid var(--border);
      margin-top: clamp(40px, 5vw, 60px);
    }
    .post-footer .home-link {
      min-height: 44px;
      padding: 0 22px;
      font-size: 13px;
      letter-spacing: 0.14em;
    }
    .post-footer .home-link svg {
      width: 16px;
      height: 16px;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 820px);
      gap: 24px;
      align-items: start;
      padding-bottom: clamp(34px, 6vw, 62px);
      border-bottom: 1px solid var(--border);
    }
    .eyebrow {
      margin: 0 0 18px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.3;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }
    h1 {
      max-width: 980px;
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(40px, 5.6vw, 68px);
      line-height: 1.05;
      letter-spacing: 0;
      text-wrap: balance;
    }
    .dek {
      max-width: 680px;
      margin: 22px 0 0;
      color: var(--muted);
      font-size: clamp(18px, 1.7vw, 22px);
      line-height: 1.55;
      text-wrap: pretty;
    }
    .hero-card {
      max-width: 680px;
      border-left: 3px solid var(--accent);
      padding: 2px 0 2px 18px;
      display: block;
    }
    .hero-card p {
      margin: 0 0 14px;
      color: var(--muted);
      font-size: 16px;
      line-height: 1.65;
    }
    .mode-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.35;
    }
    .mode {
      display: inline-flex;
      gap: 6px;
      padding: 0;
      border-bottom: 0;
    }
    .mode strong { color: var(--fg); }
    .mode span { color: var(--muted); }
    .accent-mark {
      display: inline-block;
      padding: 0 0.08em 0.02em;
      background: transparent;
      color: var(--accent-strong);
      border-bottom: 2px solid color-mix(in oklch, var(--accent) 34%, transparent);
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(180px, 250px) minmax(0, var(--max-reader));
      justify-content: center;
      gap: clamp(28px, 5vw, 54px);
      align-items: start;
      margin-top: clamp(44px, 7vw, 84px);
    }
    .toc {
      position: sticky;
      top: 28px;
      align-self: start;
      max-height: calc(100dvh - 56px);
      overflow: auto;
      padding-right: 8px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.45;
      color: var(--muted);
    }
    .toc-title {
      margin: 0 0 14px;
      color: var(--fg);
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .toc a {
      display: block;
      padding: 7px 0 7px 12px;
      border-left: 1px solid var(--border);
      text-decoration: none;
      color: var(--muted);
    }
    .toc a.active,
    .toc a:hover {
      color: var(--fg);
      border-left-color: var(--accent);
    }
    article {
      min-width: 0;
    }
    section {
      scroll-margin-top: 28px;
      padding: 18px 0 44px;
      border-bottom: 1px solid var(--border);
    }
    section:last-child {
      border-bottom: 0;
    }
    h2 {
      font-family: var(--font-display);
      line-height: 1.08;
      letter-spacing: 0;
      text-wrap: balance;
    }
    h2 {
      margin: 0 0 22px;
      font-size: clamp(30px, 4vw, 48px);
    }
    h3 {
      margin: 34px 0 14px;
      font-family: var(--font-display);
      font-size: clamp(23px, 3vw, 32px);
      font-weight: 700;
      line-height: 1.14;
      letter-spacing: 0;
      text-wrap: balance;
    }
    h3.compact-heading {
      font-size: clamp(22px, 2.5vw, 28px);
      line-height: 1.12;
    }
    .vi-readable-heading {
      font-family: Georgia, var(--font-display);
      font-weight: 680;
      line-height: 1.2;
      text-wrap: normal;
    }
    #prompts h3 {
      text-wrap: normal;
    }
    p {
      margin: 0 0 22px;
      text-wrap: pretty;
    }
    p.lead {
      font-size: clamp(22px, 2.4vw, 30px);
      line-height: 1.52;
      color: var(--fg);
    }
    .case-file {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      gap: clamp(18px, 4vw, 34px);
      margin: 0 0 34px;
      padding: 22px 0 24px;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .case-index {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.35;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }
    .case-title {
      margin: 0;
      max-width: 680px;
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.12;
      color: var(--fg);
      text-wrap: balance;
    }
    .case-title strong {
      color: var(--accent-strong);
      font-weight: 760;
    }
    .case-map {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }
    .case-map span {
      border: 1px solid var(--border);
      background: transparent;
      padding: 4px 8px;
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.25;
      letter-spacing: 0.02em;
      color: var(--muted);
    }
    ul, ol {
      margin: 0 0 24px;
      padding-left: 1.25em;
    }
    li { margin: 8px 0; }
    strong { font-weight: 720; }
    code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: color-mix(in oklch, var(--accent-soft) 64%, var(--surface));
      padding: 0.12em 0.32em;
      border-radius: 4px;
    }
    h2 code {
      white-space: nowrap;
    }
    .command-pair {
      display: inline-flex;
      align-items: baseline;
      gap: 0.16em;
      white-space: nowrap;
    }

    .callout {
      position: relative;
      margin: 34px 0;
      padding: 26px 30px 24px 58px;
      border-top: 1px solid color-mix(in oklch, var(--accent) 42%, var(--border));
      border-bottom: 1px solid var(--border);
      border-left: 0;
      background: color-mix(in oklch, var(--surface) 72%, var(--bg));
    }
    .callout::before,
    .callout::after {
      position: absolute;
      font-family: var(--font-display);
      line-height: 1;
      color: var(--accent-strong);
      pointer-events: none;
    }
    .callout::before {
      content: "“";
      top: 10px;
      left: 16px;
      font-size: 72px;
      opacity: 0.36;
    }
    .callout::after {
      content: "”";
      right: 18px;
      bottom: -10px;
      font-size: 56px;
      opacity: 0.18;
    }
    .callout p {
      position: relative;
      z-index: 1;
    }
    .callout p:last-child { margin-bottom: 0; }
    .callout .label {
      position: relative;
      z-index: 1;
      display: block;
      margin-bottom: 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }

    .table-wrap {
      overflow-x: auto;
      margin: 28px 0 34px;
      border-top: 1px solid var(--fg);
      border-bottom: 1px solid var(--fg);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 620px;
      font-size: 15px;
      line-height: 1.42;
    }
    th, td {
      padding: 14px 12px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
    }
    th {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      background: color-mix(in oklch, var(--surface) 72%, var(--bg));
    }
    tr:last-child td { border-bottom: 0; }
    td:first-child, th:first-child { padding-left: 0; }
    td:last-child, th:last-child { padding-right: 0; }

    .code-block {
      margin: 26px 0 34px;
      background: var(--code-bg);
      color: var(--code-fg);
      border: 1px solid color-mix(in oklch, var(--border) 72%, transparent);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 12px 28px rgba(0,0,0,0.12), inset 0 1px 0 rgba(255,255,255,0.08);
    }
    :root[data-theme="dark"] .code-block {
      border-color: color-mix(in oklch, var(--border) 72%, var(--accent) 18%);
      box-shadow: 0 16px 34px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.08);
    }
    .code-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 42px;
      padding: 8px 12px 8px 18px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.62);
    }
    .copy-btn {
      border: 1px solid rgba(255,255,255,0.18);
      background: rgba(255,255,255,0.08);
      color: #fff;
      min-height: 32px;
      padding: 0 10px;
      border-radius: 6px;
      font: 700 11px/1 var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.18s ease, transform 0.18s ease;
    }
    .copy-btn:hover {
      background: rgba(255,255,255,0.15);
      transform: translateY(-1px);
    }
    pre {
      margin: 0;
      padding: 22px;
      overflow: auto;
      font: 14px/1.62 var(--font-mono);
      white-space: pre;
    }
    pre code {
      background: transparent;
      color: inherit;
      padding: 0;
      border-radius: 0;
      font-size: inherit;
    }

    .decision-band {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      margin: 34px 0;
      background: var(--fg);
      border: 1px solid var(--fg);
    }
    .decision-card {
      min-height: 132px;
      padding: 20px;
      background: var(--surface);
    }
    .decision-card b {
      display: block;
      margin-bottom: 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }
    .decision-card span {
      display: block;
      font-family: var(--font-display);
      font-size: 28px;
      line-height: 1.12;
    }

    .visual-diagram {
      margin: 30px 0 36px;
      padding: 22px 0;
      border-top: 1px solid var(--fg);
      border-bottom: 1px solid var(--border);
    }
    .diagram-kicker {
      margin: 0 0 18px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.35;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }
    .diagram-node {
      position: relative;
      min-width: 0;
      padding: 16px 16px 15px;
      border: 1px solid var(--border);
      background: color-mix(in oklch, var(--surface) 76%, var(--bg));
    }
    .diagram-node strong {
      display: block;
      margin-bottom: 6px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.25;
      letter-spacing: 0.03em;
      color: var(--fg);
    }
    .diagram-node span {
      display: block;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
    }
    .pipeline-diagram {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }
    .pipeline-diagram .diagram-node::before {
      content: attr(data-step);
      position: absolute;
      top: -10px;
      left: 12px;
      padding: 0 6px;
      background: var(--bg);
      color: var(--accent-strong);
      font: 700 11px/1 var(--font-mono);
    }
    .tdd-diagram {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: 12px;
      align-items: stretch;
    }
    .tdd-diagram .diagram-node {
      display: flex;
      min-height: 132px;
      flex-direction: column;
      justify-content: center;
    }
    .diagram-arrow {
      align-self: center;
      color: var(--accent-strong);
      font: 700 18px/1 var(--font-mono);
    }
    .risk-diagram {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 14px;
    }
    .risk-diagram .diagram-node {
      border-top: 4px solid var(--accent);
    }
    .risk-result {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 160px minmax(0, 1fr);
      gap: 16px;
      align-items: center;
      padding: 16px 18px;
      border: 1px solid var(--fg);
      background: var(--surface);
    }
    .risk-result b {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.03em;
      color: var(--accent-strong);
    }
    .risk-result span {
      color: var(--muted);
      font-size: 15px;
      line-height: 1.45;
    }
    .context-flow {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .context-flow .diagram-node {
      min-height: 124px;
    }
    .practice-grid {
      display: grid;
      gap: 14px;
      margin: 24px 0 26px;
    }
    .practice-card,
    .pitfall-item {
      display: grid;
      grid-template-columns: minmax(104px, 128px) minmax(0, 1fr);
      gap: 18px;
      padding: 18px 0 20px;
      border-top: 1px solid var(--border);
    }
    .practice-card:last-child,
    .pitfall-item:last-child {
      border-bottom: 1px solid var(--border);
    }
    .practice-index,
    .pitfall-tag {
      align-self: start;
      justify-self: start;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.25;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }
    .practice-index {
      padding: 5px 8px;
      border: 1px solid var(--border);
      background: color-mix(in oklch, var(--surface) 72%, var(--bg));
    }
    .practice-card h4,
    .pitfall-item h4 {
      margin: 0 0 8px;
      font-family: Georgia, var(--font-display);
      font-size: clamp(22px, 2.15vw, 27px);
      font-weight: 700;
      line-height: 1.18;
      letter-spacing: 0;
    }
    .practice-card p,
    .pitfall-item p {
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
    }
    .review-panel {
      margin: 28px 0 32px;
      padding: 20px 0 0;
      border-top: 4px solid var(--fg);
    }
    .review-panel p {
      max-width: 680px;
    }
    .review-kicker {
      margin: 0 0 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.35;
      letter-spacing: 0.04em;
      color: var(--accent-strong);
    }
    .review-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(138px, 1fr));
      gap: 1px;
      margin-top: 18px;
      background: var(--fg);
      border: 1px solid var(--fg);
    }
    .review-item {
      position: relative;
      min-height: 150px;
      padding: 38px 14px 14px;
      background: var(--surface);
    }
    .review-item::before {
      content: attr(data-q);
      position: absolute;
      top: 12px;
      left: 14px;
      color: var(--accent-strong);
      font: 700 11px/1 var(--font-mono);
      letter-spacing: 0.04em;
    }
    .review-item b {
      display: block;
      margin-bottom: 10px;
