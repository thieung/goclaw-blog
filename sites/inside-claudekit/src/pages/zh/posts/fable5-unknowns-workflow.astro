  }

  /* ---------- TABLES ---------- */
  .table-scroll {
    overflow-x: auto;
    margin: 20px 0;
    border-radius: 12px;
    border: 1px solid var(--border);
    max-width: var(--full);
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 640px;
    font-size: 14px;
    background: var(--bg-card);
  }

  th, td {
    text-align: left;
    padding: 12px 16px;
