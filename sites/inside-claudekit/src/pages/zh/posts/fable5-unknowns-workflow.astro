  }

  .quote-block::before,
  .quote-block::after {
    position: absolute;
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1;
    color: var(--accent);
    pointer-events: none;
  }

  .quote-block::before {
    content: "“";
    top: 8px;
    left: 18px;
    font-size: 76px;
    opacity: 0.34;
  }

  .quote-block::after {
    content: "”";
    right: 22px;
    bottom: -10px;
    font-size: 58px;
    opacity: 0.16;
  }

  .quote-block .label {
    display: block;
    margin-bottom: 10px;
    color: var(--accent);
    font: 800 12px/1.25 "SF Mono", "Menlo", "Consolas", monospace;
