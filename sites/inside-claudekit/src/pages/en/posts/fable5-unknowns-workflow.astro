<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.dataset.theme = stored;
        return;
      }
    } catch (_) {}
    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
  })();
</script>
<style is:inline>
  :root {
    color-scheme: light;
    --accent: #b5502e;
    --accent-soft: #f2e2da;
    --bg: #faf7f2;
    --bg-card: #ffffff;
    --text: #211c18;
    --text-muted: #6b6259;
    --border: #e6ddd2;
    --mono-bg: #f1ece3;
    --shadow: 0 1px 3px rgba(30, 20, 10, 0.06);
    /* Full = topbar/visual ceiling. Content = khổ đọc chính, cùng mốc với intro và tổng kết. */
    --full: 1200px;
    --content: 920px;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --accent: #e08a5f;
    --accent-soft: #3a2c22;
    --bg: #17140f;
    --bg-card: #1f1b15;
    --text: #ece5da;
    --text-muted: #a49a8c;
    --border: #332c22;
    --mono-bg: #251f18;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* Main article follows the same reading width as intro and takeaways. */
  .wrap {
    max-width: var(--content);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- TOPBAR NAV ---------- */
  .topbar {
    max-width: var(--full);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
  }
  .topbar .series {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .topbar .series .product {
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .topbar .series .product::before {
    content: "";
    display: inline-block;
    width: 28px;
    height: 1px;
    margin-right: 12px;
    vertical-align: middle;
    background: color-mix(in srgb, var(--accent) 60%, var(--border));
  }
  .nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .home-link,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--text);
    font: 700 11px/1 "SF Mono", "Menlo", "Consolas", monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
  }
  .home-link svg { width: 14px; height: 14px; }
  .home-link:hover,
  .theme-toggle:hover,
  .home-link:focus-visible,
  .theme-toggle:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    outline: none;
  }

  /* ---------- HERO ---------- */
  header.hero {
    padding: 80px 24px 60px;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    display: inline-block;
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 18px;
  }

  h1.title {
    font-size: clamp(32px, 5.5vw, 52px);
    line-height: 1.15;
    margin: 0 0 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
  }

  .subtitle {
    max-width: 640px;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .subtitle .name {
    color: var(--text);
    font-weight: 600;
  }

  /* ---------- SECTIONS ---------- */
  main {
    padding: 8px 0 40px;
  }

  /* Khối đọc (text dài) giữ khổ hẹp cho dễ đọc, căn trái trong wrap rộng */
  .reader {
    max-width: var(--content);
  }

  section {
    padding: 64px 0;
    border-bottom: 1px solid var(--border);
  }

  section:last-of-type { border-bottom: none; }

  .sec-label {
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 12px;
  }

  h2 {
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.25;
    margin: 0 0 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: 19px;
    font-weight: 700;
    margin: 0 0 10px;
  }

  p { margin: 0 0 16px; }

  .lede {
    font-size: 18px;
    color: var(--text-muted);
  }

  code, .code {
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 0.9em;
    background: var(--mono-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent);
  }

  strong { font-weight: 700; }

  a { color: var(--accent); }

  /* ---------- RUMSFELD MATRIX ---------- */
  .matrix {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 28px 0;
    max-width: var(--full);
  }

  .matrix-cell {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    background: var(--bg-card);
    box-shadow: var(--shadow);
  }

  .matrix-cell.target {
    border-color: var(--accent);
    background: var(--accent-soft);
    position: relative;
  }

  .matrix-cell.target::after {
    content: "PRIMARY TARGET";
    position: absolute;
    top: -10px;
    right: 14px;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    letter-spacing: 0.08em;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 20px;
  }

  .matrix-cell .cell-title {
    font-weight: 700;
    font-size: 14.5px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .matrix-cell .cell-desc {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }

  .matrix-axis-label {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .golden-rule {
    margin: 28px 0 30px;
    padding: 22px 26px 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--border));
    border-left: 6px solid var(--accent);
    border-radius: 8px;
    font-size: 17px;
    line-height: 1.72;
    max-width: var(--content);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 12%, transparent), color-mix(in srgb, var(--accent) 3%, transparent) 44%, transparent),
      var(--bg-card);
    box-shadow: 0 18px 46px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .golden-rule > strong:first-child {
    display: block;
    margin-bottom: 12px;
    color: var(--accent);
    font: 800 12px/1.25 "SF Mono", "Menlo", "Consolas", monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------- SKILL SUMMARY GRID (như screenshot) ---------- */
  .skill-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 28px 0 8px;
  }

  .summary-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px 22px 24px;
    background: var(--bg-card);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }

  .summary-card .sc-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .summary-card .sc-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
  }
  .summary-card .sc-icon svg { width: 22px; height: 22px; }

  .summary-card .sc-name {
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
  }

  .summary-card .sc-custom {
    align-self: center;
    margin-left: auto;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
    padding: 3px 9px;
    border-radius: 20px;
  }

  .summary-card .sc-desc {
    font-size: 15.5px;
    line-height: 1.55;
    margin: 0 0 16px;
  }

  .summary-card .sc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .summary-card .sc-tag {
    font-size: 13px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 12px;
    background: color-mix(in srgb, var(--mono-bg) 60%, transparent);
  }

  /* ---------- SUBSCRIBER BANNER ---------- */
  .sub-banner {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 22px 0 4px;
    padding: 22px 24px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: 16px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 55%, transparent), transparent 60%),
      var(--bg-card);
    box-shadow: var(--shadow);
  }

  .sub-banner .sb-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
  }
  .sub-banner .sb-icon svg { width: 26px; height: 26px; }

  .sub-banner .sb-body { flex: 1 1 auto; min-width: 0; }

  .sub-banner .sb-title {
    font-size: 17px;
    font-weight: 800;
    margin: 0 0 4px;
  }

  .sub-banner .sb-desc {
    font-size: 14.5px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .sub-banner .sb-cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 14.5px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.18s ease, transform 0.18s ease;
  }
  .sub-banner .sb-cta svg { width: 16px; height: 16px; }
  .sub-banner .sb-cta:hover,
  .sub-banner .sb-cta:focus-visible {
    filter: brightness(1.08);
    transform: translateY(-1px);
    outline: none;
  }

  /* ---------- SKILL CARDS (list chi tiết) ---------- */
  .skill-detail-label {
    margin: 40px 0 4px;
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-top: 16px;
    max-width: var(--full);
  }

  .skill-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    background: var(--bg-card);
    box-shadow: var(--shadow);
  }

  .skill-card .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .skill-card .tag .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .skill-card h3 code {
    font-size: 1em;
  }

  .skill-card ul {
    margin: 12px 0 0;
    padding-left: 20px;
  }

  .skill-card li {
    margin-bottom: 6px;
    font-size: 15px;
  }

  .skill-card .deliverable {
    margin-top: 14px;
    padding: 10px 14px;
    background: var(--mono-bg);
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  /* ---------- PIPELINE FLOW ---------- */
  .pipeline {
    margin-top: 28px;
    position: relative;
    padding-left: 28px;
    max-width: var(--full);
  }

  .pipeline::before {
    content: "";
    position: absolute;
    left: 9px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--border));
    opacity: 0.5;
  }

  .stage {
    position: relative;
    padding-bottom: 28px;
  }

  .stage:last-child { padding-bottom: 0; }

  .stage::before {
    content: "";
    position: absolute;
    left: -28px;
    top: 4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 2px solid var(--accent);
  }

  .stage-box {
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: 12px;
    padding: 16px 20px;
    box-shadow: var(--shadow);
  }

  .stage-num {
    font-size: 11px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .stage-cmd {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .stage-desc {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }

  .stage-opt {
    margin-top: 8px;
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ---------- GATE VISUAL ---------- */
  .gate-visual {
    margin: 32px 0 4px;
    display: flex;
    align-items: stretch;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .scroll-hint {
    display: none;
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    margin: 0 0 24px;
  }

  .gate-node, .cook-node {
    flex: 1 1 0;
    min-width: 148px;
    border-radius: 14px;
    padding: 18px 14px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .gate-node {
    border: 2px solid var(--accent);
    background: var(--accent-soft);
  }

  .gate-node .g-label {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .gate-node .g-cmd {
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 6px;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .gate-node .g-kills {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .cook-node {
    background: var(--mono-bg);
    border: 1px dashed var(--border);
    justify-content: center;
  }

  .cook-node .c-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 700;
    margin-bottom: 4px;
  }

  .cook-node .c-cmd {
    font-size: 14px;
    font-weight: 700;
  }

  .arrow-sep {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    font-size: 18px;
    padding: 0 2px;
  }

  .gate-explain {
    display: grid;
    gap: 14px;
    margin-top: 8px;
    max-width: var(--full);
  }

  .gate-explain .g-item {
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 16px;
  }

  .gate-explain .g-item h4 {
    margin: 0 0 4px;
    font-size: 15px;
  }

  .gate-explain .g-item p {
    margin: 0;
    font-size: 14.5px;
    color: var(--text-muted);
  }

  /* Gate chéo model tuỳ chọn (Codex — khác model) */
  .gate-node.optional {
    border-style: dashed;
    background: var(--bg-card);
  }

  .gate-node.optional .g-label { color: var(--text-muted); }

  .sub-badge {
    display: inline-block;
    align-self: center;
    margin-top: 8px;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 20px;
    padding: 2px 8px;
  }

  .arrow-sep.optional { opacity: 0.45; }

  .gate-explain .g-item.optional {
    border-left-style: dashed;
  }

  /* ---------- CODEX ---------- */
  .callout {
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 14.5px;
    margin: 20px 0 28px;
    max-width: var(--content);
  }

  .callout .callout-tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    padding: 2px 9px;
    border-radius: 20px;
    margin-bottom: 8px;
  }

  .cmd-block {
    margin: 16px 0 24px;
    padding: 14px 16px;
    background: var(--mono-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: var(--content);
  }

  .loop-flow {
    margin: 20px 0;
    padding: 0;
    list-style: none;
    counter-reset: loopstep;
    max-width: var(--content);
  }

  .loop-flow li {
    position: relative;
    padding: 0 0 18px 44px;
    counter-increment: loopstep;
    font-size: 14.5px;
  }

  .loop-flow li::before {
    content: counter(loopstep);
    position: absolute;
    left: 0;
    top: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent);
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loop-flow li::after {
    content: "";
    position: absolute;
    left: 13px;
    top: 30px;
    bottom: 2px;
    width: 1.5px;
    background: var(--border);
  }

  .loop-flow li:last-child { padding-bottom: 0; }
  .loop-flow li:last-child::after { display: none; }

  .loop-flow li.human-step::before {
    background: var(--accent);
    color: #fff;
  }

  /* ---------- TABLES ---------- */
  .table-scroll {
    overflow-x: auto;
    margin: 20px 0;
    border-radius: 12px;
    border: 1px solid var(--border);
