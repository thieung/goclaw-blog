    border-radius: 20px;
    margin-bottom: 10px;
  }

  /* ---------- PROMPT MẪU ---------- */
  .prompt-box {
    margin-top: 14px;
    background: var(--mono-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
